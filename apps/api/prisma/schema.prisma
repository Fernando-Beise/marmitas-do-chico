generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id         String    @id @default(uuid())
  nome       String
  telefone   String
  email      String?   @unique
  temConta   Boolean   @default(false)
  senhaHash  String?
  criadoEm   DateTime @default(now())
  pedidos    Pedido[]
  enderecos  Endereco[]
  recebeNotificacoes Boolean  @default(true)

  @@map("clientes")
}


model Endereco {
  id               String   @id @default(uuid())
  clienteId        String
  cliente          Cliente  @relation(fields: [clienteId], references: [id])
  descricao        String
  enderecoCompleto String
  latitude         Float
  longitude        Float
  principal        Boolean  @default(false)
  pedidos          Pedido[]

  @@map("enderecos")
}

model Prato {
  id          String       @id @default(uuid())
  nome        String
  descricao   String
  preco       Decimal
  fotoUrl     String?
  disponivel  Boolean      @default(true)
  itens       ItemPedido[]
  adicionais  Adicional[]  @relation("PratoAdicionais")

  @@map("pratos")
}

model Pedido {
  id          String       @id @default(uuid())
  clienteId   String
  cliente     Cliente      @relation(fields: [clienteId], references: [id])
  enderecoId  String
  endereco    Endereco     @relation(fields: [enderecoId], references: [id])
  status      String       @default("pendente")
  total       Decimal
  criadoEm   DateTime     @default(now())
  itens       ItemPedido[]
  pagamento   Pagamento?

  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(uuid())
  pedidoId      String
  pedido        Pedido  @relation(fields: [pedidoId], references: [id])
  pratoId       String
  prato         Prato   @relation(fields: [pratoId], references: [id])
  quantidade    Int
  precoUnitario Decimal
  adicionais ItemPedidoAdicional[]

  @@map("itens_pedido")
}

model ItemPedidoAdicional {
  id           String   @id @default(uuid())
  quantidade   Int      @default(1)
  precoCobrado Float    // Salva o preço exato do momento da compra (imutável)

  itemPedidoId String
  itemPedido   ItemPedido @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)

  adicionalId  String
  adicional    Adicional  @relation(fields: [adicionalId], references: [id])
}

model Pagamento {
  id            String    @id @default(uuid())
  pedidoId      String    @unique
  pedido        Pedido    @relation(fields: [pedidoId], references: [id])
  metodo        String
  status        String    @default("pendente")
  idTransacaoMp String?
  pagoEm        DateTime?

  @@map("pagamentos")
}

model Adicional {
  id          String   @id @default(uuid())
  nome        String
  preco       Float    @default(0) // Pode ser 0 (ex: "Feijão à parte") ou ter valor (ex: "Ovo +R$2")
  disponivel  Boolean  @default(true)
  criadoEm    DateTime @default(now())
  arquivado   Boolean  @default(false)

  // Relações mágicas do Prisma (Muitos-para-Muitos)
  pratos      Prato[]      @relation("PratoAdicionais")
  itensPedidoAdicional ItemPedidoAdicional[]

  @@map("adicionais")
}