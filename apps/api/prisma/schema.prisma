generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id         String    @id @default(uuid())
  nome       String
  telefone   String    @unique
  criadoEm   DateTime @default(now())
  pedidos    Pedido[]
  enderecos  Endereco[]
  recebeNotificacoes Boolean  @default(true)

  @@map("clientes")
}

model Admin {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String   // Guardará o hash da password
  criadoEm  DateTime @default(now())

  @@map("admin")
}

model Endereco {
  id          String   @id @default(uuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  
  // Campos fragmentados e limpos
  cep         String
  rua         String
  numero      String
  bairro      String
  cidade      String
  estado      String
  complemento String?  // Opcional, caso o cliente queira adicionar "Apto 201" no futuro
  
  pedidos     Pedido[]

  @@map("enderecos")
}

model Prato {
  id          String       @id @default(uuid())
  nome        String
  descricao   String
  preco       Decimal
  fotoUrl     String?
  arquivado   Boolean      @default(false)
  disponivel  Boolean      @default(true)
  itens       ItemPedido[]
  adicionais  Adicional[]  @relation("PratoAdicionais")

  @@map("pratos")
}

model Pedido {
  id          String       @id @default(uuid())
  clienteId   String
  cliente     Cliente      @relation(fields: [clienteId], references: [id])
  enderecoId  String
  endereco    Endereco     @relation(fields: [enderecoId], references: [id])
  status      String       @default("pendente")
  total       Decimal
  taxa	      Decimal	   @default(0)
  criadoEm   DateTime     @default(now())
  atualizadoEm DateTime	   @updatedAt
  itens       ItemPedido[]
  pagamento   Pagamento?

  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(uuid())
  pedidoId      String
  pedido        Pedido  @relation(fields: [pedidoId], references: [id])
  pratoId       String
  prato         Prato   @relation(fields: [pratoId], references: [id])
  quantidade    Int
  precoUnitario Decimal
  adicionais ItemPedidoAdicional[]

  @@map("itens_pedido")
}

model ItemPedidoAdicional {
  id           String   @id @default(uuid())
  quantidade   Int      @default(1)
  precoCobrado Float    // Salva o preço exato do momento da compra (imutável)

  itemPedidoId String
  itemPedido   ItemPedido @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)

  adicionalId  String
  adicional    Adicional  @relation(fields: [adicionalId], references: [id])
}

model Pagamento {
  id            String    @id @default(uuid())
  pedidoId      String    @unique
  pedido        Pedido    @relation(fields: [pedidoId], references: [id])
  metodo        String
  status        String    @default("pendente")
  idTransacaoMp String?
  pagoEm        DateTime?

  @@map("pagamentos")
}

model Adicional {
  id          String   @id @default(uuid())
  nome        String
  preco       Float    @default(0) // Pode ser 0 (ex: "Feijão à parte") ou ter valor (ex: "Ovo +R$2")
  disponivel  Boolean  @default(true)
  criadoEm    DateTime @default(now())
  arquivado   Boolean  @default(false)

  // Relações mágicas do Prisma (Muitos-para-Muitos)
  pratos      Prato[]      @relation("PratoAdicionais")
  itensPedidoAdicional ItemPedidoAdicional[]

  @@map("adicionais")
}

// TABELA PARA CONTROLA SE A LOJA ESTÁ ABERTA OU FECHADA
model LojaConfig {
  id        String   @id @default("padrao") // Usamos um ID fixo para ter sempre apenas 1 linha
  aberta    Boolean  @default(false)
  atualizadoEm DateTime @updatedAt

  @@map("loja")
}
